# asx-mcp Environment Configuration

# Cache directory for the ASX company directory (refreshed daily)
# Default: /tmp/asx_cache (local) or /app/cache (Docker)
CACHE_DIR=/tmp/asx_cache

# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Server bind address and port
# Default: 127.0.0.1 (local) or 0.0.0.0 (Docker)
HOST=127.0.0.1
PORT=8000

# Server log level
LOG_LEVEL=INFO
